# FoodBridge Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
GCP_PROJECT_ID=foodbridge-dev
GCP_REGION=asia-south1

# Service Ports (Local development)
LISTING_SERVICE_PORT=8001
MATCHING_SERVICE_PORT=8002
NOTIFICATION_SERVICE_PORT=8003
LOGISTICS_SERVICE_PORT=8004
ANALYTICS_SERVICE_PORT=8005
EXPIRY_JOB_PORT=8006
WEB_PORT=5173

# Event Bus & Cloud Messaging
# Options: "in-memory" (zero-credentials default) or "pubsub"
EVENT_BUS_TYPE=in-memory
PUBSUB_EMULATOR_HOST=
PUBSUB_PROJECT_ID=foodbridge-dev

# Cloud Tasks / Delayed Execution
# Options: "in-memory" or "cloud-tasks"
TASK_DISPATCHER_TYPE=in-memory

# Storage & Database
# Leave blank for local in-memory fallback, or specify emulator host
FIRESTORE_EMULATOR_HOST=
FIRESTORE_DATABASE=(default)
GCS_BUCKET_NAME=foodbridge-photos
STORAGE_EMULATOR_HOST=

# AI (Google Gemini)
# If empty, gracefully falls back to deterministic rule-based heuristics
GEMINI_API_KEY=

# Notifications (FCM / SMS)
FCM_SERVER_KEY=
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=+1234567890

# Algorithm & Impact Parameters
SAFETY_MARGIN_MINUTES=30
HANDOVER_BUFFER_MINUTES=15
CO2E_FACTOR_KG_PER_KG=2.5
AVERAGE_MEAL_WEIGHT_KG=0.35
MAX_OFFER_RADIUS_KM=25.0
EXPANDED_RADIUS_KM=40.0
